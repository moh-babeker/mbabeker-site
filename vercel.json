{
  "framework": null,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/projects/:slug", "destination": "/project.html" },
    { "source": "/articles", "destination": "/article.html" },
    { "source": "/articles/:slug", "destination": "/article.html" },
    { "source": "/:slug", "destination": "/page.html" }
  ],
  "headers": [
    {
      "source": "/content/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
